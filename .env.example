# Koneksi PostgreSQL. Lokal: jalankan `docker compose up -d` (port 5433 supaya tidak bentrok dengan Postgres lain).
DATABASE_URL="postgresql://kasir:kasir@localhost:5433/kasir_pos"

# Kunci enkripsi cookie session, minimal 32 karakter. Buat dengan: openssl rand -base64 32
AUTH_SECRET=""

# Kunci HMAC untuk webhook provider pembayaran simulasi, minimal 16 karakter.
MOCK_WEBHOOK_SECRET=""

# Provider pembayaran non-tunai. Saat ini hanya "mock" (simulasi).
PAYMENT_PROVIDER="mock"

# Opsional: lama terminal EDC simulasi "berpikir" (ms). Kosong = acak 2000 sampai 4000.
# MOCK_TERMINAL_DELAY_MS=""

# URL publik aplikasi. Isi QR memakai alamat yang sedang dibuka pengunjung; ini hanya cadangan.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
